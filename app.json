{
  "expo": {
    "name": "Anotei",
    "slug": "trackingwaste",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/IconLogo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/IconLogo.png",
        "backgroundColor": "#000000"
      },
      "package": "com.owdail10.anotei"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Anotei",
      "shortName": "Anotei",
      "lang": "pt-BR",
      "themeColor": "#ffffff",
      "backgroundColor": "#f4f6fa"
    },
    "extra": {
      "eas": {
        "projectId": "f01286d3-cc88-4de7-aca3-bcd598ad36e7"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/IconLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
